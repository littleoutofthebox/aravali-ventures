---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = 'Aravali Ventures · Connecting investors with high-potential startups',
  description = 'Aravali Ventures Private Limited connects investors, family offices and funds with high-potential startups, backed by a team with industry, legal and financial expertise.',
  image = '/images/092749b22adb654b1872344154eee48c.jpg',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/735d5f722b7251bdb85d64e249e1b5aa.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0B0B0B" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { margin: 0; background: #0B0B0B; overflow-x: clip; -webkit-font-smoothing: antialiased; }
  a { color: #F4EFE7; }
  a:hover { color: #E0474B; }
  ::selection { background: #C8242A; color: #FFFFFF; }
  img { max-width: 100%; }
  [hidden] { display: none !important; }
  .aud-pane { display: contents; }

  .aud-tab, .aud-seg {
    min-height: 44px; padding: 0 22px; border: 0; border-radius: 999px;
    background: transparent; color: #0B0B0B; font: 500 13px Montserrat, sans-serif; cursor: pointer;
  }
  .aud-seg { flex: 1 1 100px; padding: 0; }
  .aud-tab[aria-selected='true'], .aud-seg[aria-pressed='true'] {
    background: #0B0B0B; color: #FFFFFF; font-weight: 600;
  }
  @media (max-width: 760px) {
    [style*='grid-template-columns: repeat(auto-fit, minmax('] { grid-template-columns: 1fr !important; }
    [style*='padding: 56px'] { padding: 32px 20px !important; }
    [style*='padding: 48px 56px'] { padding: 32px 20px 24px !important; }
    [style*='padding: 40px 48px'] { padding: 24px 20px 28px !important; }
    [style*='padding: 36px'] { padding: 24px 18px !important; }
    [style*='padding: 26px 40px'] { padding: 22px 20px !important; }
    [style*='repeat(4, minmax(0, 1fr))'], [style*='repeat(3, minmax(0, 1fr))'] { grid-template-columns: 1fr !important; grid-auto-rows: 240px !important; }
    [style*='repeat(4, minmax(0, 1fr))'] > *, [style*='repeat(3, minmax(0, 1fr))'] > * { grid-column: auto !important; grid-row: auto !important; }
    #venue > :first-child { height: auto; padding: 32px 20px !important; }
    #venue { grid-auto-rows: auto !important; }
    #venue > :not(:first-child) { height: 240px; }
    nav[aria-label='Main'] a:not(:last-child) { display: none !important; }
    nav[aria-label='Main'] { padding: 0 !important; border: 0 !important; background: none !important; }
    [style*='min-height: 860px'] { min-height: 640px !important; }
    [style*='gap: 64px'] { gap: 28px !important; }
  }
  .form-note { margin: 0; font-size: 13px; line-height: 1.6; color: #2E6B3A; }
</style>

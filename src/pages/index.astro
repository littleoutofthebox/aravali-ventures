---
import Base from '../layouts/Base.astro';
import programme from '../content/parts/programme.html?raw';
import venue from '../content/parts/venue.html?raw';
import invite from '../content/parts/invite.html?raw';

const img = {
  logo: '/images/735d5f722b7251bdb85d64e249e1b5aa.png',
  palace: '/images/4e49ac4d5af10c709084df905cc2e0b8.jpg',
  handshake: '/images/c8024809b47751bf4068834578619de1.jpg',
  pitch: '/images/fad226008d9abf3a9747be4e284db0b3.jpg',
};

const highlights = [
  { k: 'Top HNIs', t: 'From Tier-2 and Tier-3 cities', d: 'Leading business families, industrialists and high-net-worth investors from Udaipur, Jaipur, Jodhpur, Kota and beyond.' },
  { k: '1 question', t: 'How to evaluate a startup', d: 'The whole evening is built around one practical skill: judging a startup before you put money in.' },
  { k: '6 startups', t: 'Curated, from six domains', d: 'Six screened startups from different sectors showcase live, each evaluated in the room.' },
  { k: 'Awareness', t: 'Startup investing, demystified', d: 'Built to educate first: what to look for, what to ask and how to start small and safely.' },
];

const framework = [
  { n: '01', t: 'The founder', d: 'Commitment, capability and integrity. How to judge the people behind the pitch.' },
  { n: '02', t: 'The problem and market', d: 'Is the problem real, is the market large enough, and why now?' },
  { n: '03', t: 'The business model', d: 'How the company makes money, and whether the unit economics can work at scale.' },
  { n: '04', t: 'Traction and financials', d: 'Reading early numbers honestly, and separating real progress from a good story.' },
  { n: '05', t: 'Valuation and terms', d: 'What a fair price looks like, and the terms that protect a first-time investor.' },
  { n: '06', t: 'Legal and risk', d: 'Due diligence, documentation and the red flags to check before you sign.' },
];

const investorPoints = [
  'A practical framework for evaluating any startup',
  'Six screened startups, with structured profiles shared in advance',
  'Live expert evaluation of each pitch: what to ask and what to watch',
  'Legal and financial guidance if you choose to invest',
];

const startupPoints = [
  'One of only six showcase slots at the summit',
  'Present to leading HNIs and business families from Tier-2 and Tier-3 cities',
  'Help preparing your pitch, financial model and key metrics',
  'Investor follow-up and guidance on terms after the evening',
];

const different = [
  { t: 'Built for Tier-2 and Tier-3 investors', d: 'Designed around the real questions of business leaders outside the metros, not for professional funds alone.' },
  { t: 'Learning first, investing second', d: 'The aim is awareness and confidence. Nobody is pushed to invest on the night.' },
  { t: 'Curated, not crowded', d: 'Only six startups, each screened by our team, so every pitch gets the attention it deserves.' },
];

const expertise = [
  { t: 'Industry', d: 'Operators and business leaders with hands-on experience building, scaling and running companies across sectors.' },
  { t: 'Legal', d: 'Specialists in transaction structuring, investment documentation, compliance and governance.' },
  { t: 'Financial', d: 'Deep capability in financial analysis, valuation, due diligence and capital structuring.' },
  { t: 'Ecosystem', d: 'Long-standing relationships with founders, angels, family offices, funds, incubators and accelerators.' },
];
---

<Base
  title="Udaipur Investor Summit · How should an HNI evaluate a startup? · 19 Nov 2026"
  description="An invitation-only evening for top HNIs from Tier-2 and Tier-3 cities on how to evaluate a startup before investing, with six curated startup showcases from six domains. Hosted by Aravali Ventures. 19 November 2026, Holymont Resort, Udaipur."
  image="/images/4e49ac4d5af10c709084df905cc2e0b8.jpg"
>
  <div class="page">
    <section class="hero" id="top">
      <img class="hero-bg" src={img.palace} alt="The Lake Palace lit at night on Lake Pichola, Udaipur" style="object-position: 50% 70%" />
      <div class="hero-shade"></div>
      <header class="nav">
        <a href="/" aria-label="Aravali Ventures home"><img src={img.logo} alt="Aravali Ventures" class="logo" /></a>
        <nav aria-label="Main">
          <a href="#why" class="hide-sm">Why attend</a>
          <a href="#learn" class="hide-sm">What you'll learn</a>
          <a href="#startups-six" class="hide-sm">Six startups</a>
          <a href="#programme" class="hide-sm">Programme</a>
          <a href="#venue" class="hide-sm">Venue</a>
          <a href="#invite" class="pill">Request invitation</a>
        </nav>
      </header>
      <div class="hero-body hero-grid">
        <div class="hero-main">
          <span class="badge"><span class="dot"></span>By invitation only · Hosted by Aravali Ventures</span>
          <h1>Udaipur Investor Summit</h1>
          <p class="hero-q">How should you evaluate a startup before you invest?</p>
          <p class="lede">
            An evening for top HNIs and business families from Tier-2 and Tier-3 cities to learn how startup
            investing really works, and to see it applied live on six curated startups from six different domains.
          </p>
          <div class="ctas">
            <a href="#invite" class="btn red">Request invitation <span aria-hidden="true">→</span></a>
            <a href="#startups" class="btn ghost">Apply to showcase</a>
          </div>
        </div>
        <dl class="hero-facts">
          <div><dt>Date</dt><dd>19 November 2026</dd></div>
          <div><dt>Time</dt><dd>4:00 PM onwards</dd></div>
          <div><dt>Venue</dt><dd>Holymont Resort, Udaipur</dd></div>
        </dl>
      </div>
    </section>

    <section class="usps" aria-label="Summit highlights">
      {
        highlights.map((h) => (
          <article class="usp">
            <span class="usp-k">{h.k}</span>
            <h3>{h.t}</h3>
            <p>{h.d}</p>
          </article>
        ))
      }
    </section>

    <section class="card cream story" id="why">
      <div class="story-head">
        <span class="eyebrow eb-dark">01 · Why this summit</span>
        <h2>Our cities have the capital. What's missing is a way to judge the opportunity.</h2>
      </div>
      <div class="story-body">
        <p>
          Across Rajasthan and India's Tier-2 and Tier-3 cities, successful business owners understand
          business exceptionally well. Many now want to back young founders: to share their experience,
          open their networks and take part in the value those companies create. Most want to start small,
          with ₹5 or ₹10 lakh in a promising early-stage company.
        </p>
        <p>
          Some have tried, through startup networks, incubators and pitch events. Too often those
          investments struggle or stall, and the investor returns to the businesses he already knows. The
          problem is rarely a lack of capital. It is the lack of a reliable way to answer one question:
        </p>
        <blockquote>“How do I identify the right founder, the right business and the right opportunity before I invest?”</blockquote>
        <p class="sign">The Udaipur Investor Summit exists to answer it.</p>
      </div>
    </section>

    <section class="card dark" id="learn">
      <div class="head-row">
        <div>
          <span class="eyebrow">02 · What you'll learn</span>
          <h2>How to evaluate a startup, step by step.</h2>
        </div>
        <p class="aside">A practical framework, taught by industry, legal and financial experts, and applied live to every startup on stage.</p>
      </div>
      <div class="steps six">
        {
          framework.map((s) => (
            <article class="step">
              <span class="num">{s.n}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="card red-card six-card" id="startups-six">
      <div class="head-row">
        <div>
          <span class="eyebrow eb-light">03 · The showcase</span>
          <h2>Six startups. Six domains. Evaluated live.</h2>
        </div>
        <p class="aside light">
          Each startup is screened by our team and profiled in advance. On the night, founders pitch and our
          panel shows you exactly how to assess what you have just heard.
        </p>
      </div>
      <div class="slots">
        {
          [1, 2, 3, 4, 5, 6].map((n) => (
            <div class="slot">
              <span class="slot-n">0{n}</span>
              <span class="slot-t">Showcase {n}</span>
              <span class="slot-d">Domain revealed to confirmed guests</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="card cream principles-card">
      <span class="eyebrow eb-dark">04 · What makes it different</span>
      <div class="principles">
        {
          different.map((p) => (
            <article>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </article>
          ))
        }
      </div>
    </section>

    <Fragment set:html={programme} />

    <section class="split">
      <article class="card cream who" id="investors">
        <span class="eyebrow eb-dark">For HNIs and investors</span>
        <h3>Invest with knowledge, not guesswork.</h3>
        <ul class="list">{investorPoints.map((p) => <li>{p}</li>)}</ul>
        <a class="btn black" href="#invite" data-pick="I">Request a seat <span aria-hidden="true">→</span></a>
      </article>
      <article class="card dark who" id="startups">
        <span class="eyebrow">For startups</span>
        <h3>Six slots. One room of serious investors.</h3>
        <ul class="list">{startupPoints.map((p) => <li>{p}</li>)}</ul>
        <a class="btn red" href="#invite" data-pick="F">Apply to showcase <span aria-hidden="true">→</span></a>
      </article>
    </section>

    <section class="card dark" id="host">
      <div class="head-row">
        <div>
          <span class="eyebrow">06 · Hosted by Aravali Ventures</span>
          <h2>Expertise across every side of a deal.</h2>
        </div>
        <p class="aside">
          The summit is hosted by Aravali Ventures Private Limited, a team of industry, legal and financial
          professionals with a deep understanding of India's startup and investment ecosystem.
        </p>
      </div>
      <div class="steps">
        {
          expertise.map((e) => (
            <article class="step">
              <h3>{e.t}</h3>
              <p>{e.d}</p>
            </article>
          ))
        }
      </div>
    </section>

    <Fragment set:html={venue} />

    <Fragment set:html={invite} />

    <footer class="card dark foot">
      <div class="foot-top">
        <img src={img.logo} alt="Aravali Ventures" class="foot-logo" />
        <div class="foot-cols">
          <div><span class="label">The Summit</span><span>19 November 2026</span><span>4:00 PM onwards</span><span>Holymont Resort, Udaipur</span></div>
          <div><span class="label">Contact</span><span>Aravali Ventures</span><a href="mailto:contact@aravali.ventures">contact@aravali.ventures</a><a href="tel:+918696940199">+91 86969 40199</a></div>
        </div>
      </div>
      <div class="foot-big">Invest with knowledge</div>
      <div class="foot-bottom"><span>© 2026 Aravali Ventures Private Limited · aravali.ventures</span><span>Attendance by invitation only</span></div>
    </footer>
  </div>
</Base>

<script>
  const show = (aud: string) => {
    document.querySelectorAll<HTMLElement>('[data-aud-show]').forEach((el) => {
      el.hidden = el.dataset.audShow !== aud;
    });
    document.querySelectorAll<HTMLButtonElement>('.aud-tab').forEach((b) =>
      b.setAttribute('aria-selected', String(b.dataset.aud === aud)),
    );
    document.querySelectorAll<HTMLButtonElement>('.aud-seg').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.aud === aud)),
    );
  };
  document.querySelectorAll<HTMLButtonElement>('.aud-tab, .aud-seg').forEach((b) =>
    b.addEventListener('click', () => show(b.dataset.aud!)),
  );

  document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((a) =>
    a.addEventListener('click', () => show(a.dataset.pick!)),
  );

  const roles: Record<string, string> = { F: 'Startup', I: 'Investor', P: 'Partner' };
  const form = document.getElementById('invite-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const active = document.querySelector<HTMLButtonElement>('.aud-seg[aria-pressed="true"]')?.dataset.aud ?? 'F';
    const lines = [`Attending as: ${roles[active]}`];
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[name], select[name]').forEach((f) => {
      if (f.closest('[hidden]')) return;
      lines.push(`${f.name}: ${f.value}`);
    });
    const name = (form.querySelector('[name="Full name"]') as HTMLInputElement)?.value || roles[active];
    const subject = `Udaipur Investor Summit: invitation request (${roles[active]}, ${name})`;
    window.location.href = `mailto:contact@aravali.ventures?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
  });
</script>

<style>
  .page {
    background: #0b0b0b; color: #f4efe7; font-family: 'Montserrat', sans-serif;
    padding: 16px; display: flex; flex-direction: column; gap: 16px;
  }
  h1, h2, h3 { margin: 0; letter-spacing: -0.025em; }
  h2 { font-size: clamp(2rem, 3.4vw, 3.2rem); font-weight: 600; line-height: 1.1; }
  h3 { font-size: 24px; font-weight: 600; line-height: 1.25; }
  p { margin: 0; line-height: 1.7; }
  .card { border-radius: 28px; padding: 56px; }
  .dark { background: #161616; border: 1px solid #262626; }
  .cream { background: #f4efe7; color: #0b0b0b; }
  .cream a:not(.btn) { color: #0b0b0b; }
  .red-card { background: #c8242a; color: #fff; }
  .eyebrow { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #e0474b; margin-bottom: 16px; }
  .eyebrow.eb-dark { color: #b52025; }
  .eyebrow.eb-light { color: #ffd9d6; }
  .muted { color: #a8a196; }
  .muted-p { color: #a8a196; }
  .label { font-size: 12px; font-weight: 600; color: inherit; opacity: 0.7; }

  .btn {
    display: inline-flex; align-items: center; gap: 10px; min-height: 54px; padding: 0 28px;
    border-radius: 999px; font-size: 14px; font-weight: 600; text-decoration: none; box-sizing: border-box;
  }
  .btn.red { background: #c8242a; color: #fff; }
  .btn.ghost { background: rgba(244, 239, 231, 0.1); border: 1px solid rgba(244, 239, 231, 0.35); color: #f4efe7; }
  .btn.black { background: #0b0b0b; color: #fff; }
  .btn.cream-btn { background: #f4efe7; color: #0b0b0b; }
  .btn:hover { filter: brightness(1.1); }

  /* hero */
  .hero { position: relative; border-radius: 28px; overflow: hidden; min-height: 820px; display: flex; flex-direction: column; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,11,11,0.55) 0%, rgba(11,11,11,0.1) 30%, rgba(11,11,11,0.9) 100%), linear-gradient(90deg, rgba(11,11,11,0.75) 0%, rgba(11,11,11,0.35) 50%, rgba(11,11,11,0) 75%); }
  .nav { position: relative; padding: 24px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .logo { height: 50px; width: auto; display: block; }
  .nav nav {
    display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 999px;
    background: rgba(11,11,11,0.55); border: 1px solid rgba(244,239,231,0.18); font-size: 13px; font-weight: 500;
  }
  .nav nav a { color: #f4efe7; text-decoration: none; padding: 0 16px; min-height: 40px; display: inline-flex; align-items: center; border-radius: 999px; }
  .nav nav a.pill { background: #f4efe7; color: #0b0b0b; font-weight: 600; }
  .hero-body { position: relative; margin-top: auto; padding: 40px 48px 56px; display: flex; flex-direction: column; gap: 24px; max-width: 900px; }
  .badge {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px; border-radius: 999px;
    background: rgba(200,36,42,0.18); border: 1px solid rgba(224,71,75,0.55); font-size: 12px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: #f4efe7;
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #e0474b; }
  .hero h1 { font-size: clamp(2.6rem, 5.4vw, 5.2rem); font-weight: 700; line-height: 1.02; letter-spacing: -0.035em; }
  .lede { font-size: 20px; line-height: 1.6; color: #dcd4c6; max-width: 640px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }

  .hero-grid { max-width: none; flex-direction: row; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 40px; }
  .hero-main { flex: 1 1 560px; max-width: 860px; display: flex; flex-direction: column; gap: 24px; }
  .hero-facts { flex: 0 1 320px; min-width: 260px; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .hero-facts div { padding: 18px 22px; border-radius: 18px; background: rgba(11,11,11,0.6); border: 1px solid rgba(244,239,231,0.16); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .hero-facts dt { font-size: 12px; color: #a8a196; }
  .hero-facts dd { margin: 0; font-size: 16px; font-weight: 600; text-align: right; }
  .hero-q { margin: -6px 0 0; font-size: clamp(1.3rem, 2.4vw, 2rem); font-weight: 600; line-height: 1.25; color: #f4efe7; letter-spacing: -0.015em; }
  .usps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .usp { border-radius: 24px; background: #161616; border: 1px solid #262626; padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .usp:nth-child(3) { background: #c8242a; border-color: #c8242a; }
  .usp-k { font-size: clamp(1.8rem, 2.6vw, 2.4rem); font-weight: 700; letter-spacing: -0.03em; color: #e0474b; }
  .usp:nth-child(3) .usp-k { color: #fff; }
  .usp h3 { font-size: 18px; }
  .usp p { font-size: 14px; color: #a8a196; }
  .usp:nth-child(3) p { color: #ffe1de; }
  .steps.six { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .aside.light { color: #ffe1de; }
  .slots { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  .slot { border-radius: 20px; background: rgba(0,0,0,0.18); border: 1px solid rgba(255,255,255,0.25); padding: 22px; min-height: 180px; display: flex; flex-direction: column; gap: 8px; }
  .slot-n { font-size: 32px; font-weight: 800; letter-spacing: -0.03em; }
  .slot-t { margin-top: auto; font-size: 16px; font-weight: 600; }
  .slot-d { font-size: 12px; color: #ffe1de; line-height: 1.5; }
  .dark .list li { background: #0b0b0b; border: 1px solid #262626; }
  .strip {
    border-radius: 28px; background: #c8242a; color: #fff; padding: 26px 40px; display: flex; flex-wrap: wrap;
    justify-content: space-between; align-items: center; gap: 14px 28px; font-size: 15px; font-weight: 600;
  }

  /* story */
  .story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 56px; }
  .steps.five { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .principles article { border-top: 2px solid #c8242a; padding-top: 20px; display: flex; flex-direction: column; gap: 10px; }
  .principles p { color: #4a453f; }
  .story-body { display: flex; flex-direction: column; gap: 18px; font-size: 17px; color: #2e2a25; }
  blockquote {
    margin: 12px 0 0; padding: 28px 32px; border-radius: 22px; background: #0b0b0b; color: #f4efe7;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem); font-weight: 600; line-height: 1.35; letter-spacing: -0.015em;
  }
  .sign { font-size: 14px; font-weight: 600; color: #6b645a; }

  .problem .big { font-size: clamp(2rem, 4.2vw, 4rem); max-width: 1100px; }

  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .side { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .side img { width: 100%; height: 300px; object-fit: cover; display: block; }
  .side-body { padding: 40px; display: flex; flex-direction: column; gap: 16px; }
  .side-body p { color: #dcd4c6; }
  .side-body .muted-p { color: #a8a196; }
  .ticks { list-style: none; padding: 0; margin: 4px 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .ticks li { padding: 12px 16px; border-radius: 14px; background: #0b0b0b; border: 1px solid #262626; font-size: 14px; font-weight: 500; }

  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 40px; }
  .head-row h2 { max-width: 720px; }
  .aside { max-width: 380px; font-size: 15px; color: #a8a196; }
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .step { border-radius: 22px; background: #0b0b0b; border: 1px solid #262626; padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .step .num { align-self: flex-start; padding: 6px 12px; border-radius: 999px; background: #c8242a; color: #fff; font-size: 12px; font-weight: 700; }
  .step p { font-size: 15px; color: #a8a196; }

  .who { display: flex; flex-direction: column; gap: 20px; }
  .who h3 { font-size: clamp(1.6rem, 2.6vw, 2.4rem); }
  .list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; flex-grow: 1; }
  .list li { padding: 16px 20px; border-radius: 16px; font-size: 15px; font-weight: 500; }
  .cream .list li { background: #fff; }
  .red-card .list li { background: rgba(0, 0, 0, 0.16); }
  .who .btn { align-self: flex-start; }

  .event { position: relative; border-radius: 28px; overflow: hidden; min-height: 620px; display: flex; }
  .event img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 70%; }
  .event-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,11,11,0.92) 0%, rgba(11,11,11,0.55) 55%, rgba(11,11,11,0.1) 100%); }
  .event-body { position: relative; margin-top: auto; padding: 56px; display: flex; flex-direction: column; gap: 22px; max-width: 680px; }
  .event h2 { font-size: clamp(2.4rem, 5vw, 4.6rem); font-weight: 700; line-height: 1; letter-spacing: -0.035em; }
  .event p { font-size: 18px; color: #dcd4c6; }
  .facts { display: flex; flex-wrap: wrap; gap: 10px; }
  .facts span { padding: 10px 16px; border-radius: 999px; background: rgba(11,11,11,0.6); border: 1px solid rgba(244,239,231,0.2); font-size: 14px; font-weight: 600; }
